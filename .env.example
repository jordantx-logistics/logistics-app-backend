APP_NAME=Logistics
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Rol del contenedor: web | horizon | scheduler (ver docker/entrypoint.sh)
APP_ROLE=web

# URL del frontend (CORS/redirects)
FRONTEND_URL=http://localhost:5173

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=json
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# Base de datos (MySQL)
# ============================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=logistics_app
DB_USERNAME=logistics
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# ============================================
# Redis (caché, sesión y colas)
# ============================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

# ============================================
# Horizon (workers de cola)
# ============================================
# El worker vive en el perfil `horizon` de compose:
#   docker compose --profile horizon up -d horizon
# El panel está en http://localhost:8000/horizon. En local entra cualquiera;
# fuera de local solo los emails de esta lista (vacía = nadie, manda el borde).
HORIZON_ALLOWED_EMAILS=

# ============================================
# Outbox (consumidor `outbox:consume`)
# ============================================
# El consumidor va con el rol `scheduler` (`routes/console.php`), no con la web.
OUTBOX_BATCH=100
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE=5
OUTBOX_BACKOFF_CAP=600
OUTBOX_PROCESSING_TIMEOUT=300

# ============================================
# Octane (FrankenPHP)
# ============================================
OCTANE_SERVER=frankenphp
OCTANE_WORKERS=2
OCTANE_MAX_REQUESTS=500
# Nivel de log de Caddy (los logs de la app se rigen por LOG_LEVEL). Con
# cualquier valor, Octane imprime en crudo el stderr de los workers.
OCTANE_LOG_LEVEL=warn

# ============================================
# Métricas (Prometheus)
# ============================================
METRICS_ENABLED=true
METRICS_STORAGE=redis
# Token del scrape. Vacío = solo se atiende desde red privada (clúster).
METRICS_TOKEN=

# ============================================
# Correo (local: mailpit -> http://localhost:8025)
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@logistica.pe"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ============================================
# Autenticación (Sanctum)
# ============================================
# Web: sesión por cookie HttpOnly (solo para los dominios de SANCTUM_STATEFUL_DOMAINS);
# apps/PDA: token opaco en `Authorization: Bearer`.
# En local el frontend es Vite (http://localhost:5173) y la API :8000, así que
# la cookie es de `localhost` y no puede ser `Secure`.
# En producción (Fase 9): SANCTUM_STATEFUL_DOMAINS=app.empresa.com,
# SESSION_DOMAIN=.empresa.com y SESSION_SECURE_COOKIE=true
# (ver spec/02-objetivo/03-autenticacion.md).
SANCTUM_STATEFUL_DOMAINS=localhost:5173
# Vida del token de app, en minutos (30 días). Vacío = sin caducidad.
SANCTUM_TOKEN_EXPIRATION=43200
SESSION_SECURE_COOKIE=false

# Interruptor de emergencia del middleware de permisos (rollback de la Fase 1):
# `false` deja pasar todas las rutas y lo registra en el log. Nunca permanente.
AUTHZ_ENFORCE=true

# ============================================
# Scribe (documentación de API)
# ============================================
SCRIBE_AUTH_ENABLED=true
SCRIBE_AUTH_EMAIL=admin@admin.pe
SCRIBE_AUTH_PASSWORD='SecureAdmin2026!@#'
SCRIBE_AUTH_KEY=

VITE_APP_NAME="${APP_NAME}"
