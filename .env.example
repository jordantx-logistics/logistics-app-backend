APP_NAME=Logistics
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Rol del contenedor: web | horizon | scheduler (ver docker/entrypoint.sh)
APP_ROLE=web

# URL del frontend (CORS/redirects)
FRONTEND_URL=http://localhost:5173

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=json
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# Base de datos (MySQL)
# ============================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=logistics_app
DB_USERNAME=logistics
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# ============================================
# Redis (caché, sesión y colas)
# ============================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

# ============================================
# Octane (FrankenPHP)
# ============================================
OCTANE_SERVER=frankenphp
OCTANE_WORKERS=2
OCTANE_MAX_REQUESTS=500
# Nivel de log de Caddy (los logs de la app se rigen por LOG_LEVEL). Con
# cualquier valor, Octane imprime en crudo el stderr de los workers.
OCTANE_LOG_LEVEL=warn

# ============================================
# Correo (local: mailpit -> http://localhost:8025)
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@logistica.pe"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ============================================
# JWT (temporal: se elimina en la Fase 1 al migrar a Sanctum)
# ============================================
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0

# ============================================
# Scribe (documentación de API)
# ============================================
SCRIBE_AUTH_ENABLED=true
SCRIBE_AUTH_EMAIL=admin@admin.pe
SCRIBE_AUTH_PASSWORD='SecureAdmin2026!@#'
SCRIBE_AUTH_KEY=

VITE_APP_NAME="${APP_NAME}"
